# Mirrors kitty/.config/kitty/kitty.conf — keep the two in sync.

# background/foreground/color0-15 in kitty.conf
theme = Dracula

# font_family / font_size in kitty.conf
font-family = FiraCode Nerd Font Mono
font-size = 15

# cursor_shape / cursor_blink_interval in kitty.conf; colours come from the theme
cursor-style = block
cursor-style-blink = false

# Shell integration's vi-mode cursor handling overrides cursor-style/-blink
# above (bar cursor in insert mode, forced blink) regardless of what they're
# set to. Keep shell integration's other features (title, path, etc.), just
# drop the cursor one.
shell-integration-features = no-cursor

# hide_window_decorations titlebar-only: no titlebar, window stays resizable.
macos-titlebar-style = hidden

# Without this, Option is consumed as a dead-key/compose input instead of
# acting as Alt, so alt+backspace (delete word) and similar keybinds don't fire.
macos-option-as-alt = true

# More line spacing.
adjust-cell-height = 20%
