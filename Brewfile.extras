# Everything installed on this machine that the dotfiles do NOT need.
# bootstrap.sh deliberately does not install this file. Install it by hand:
#   brew bundle install --file=Brewfile.extras
#
# Generated by `brew bundle dump` with every entry in the core Brewfile removed.
# The tap lines are kept on purpose: some entries below are unreachable without
# them on a fresh machine (heroku needs heroku/brew, ntfs-3g-mac needs gromgit/fuse).

tap "goreleaser/tap", trusted: true
tap "gromgit/fuse", trusted: true
tap "heroku/brew", trusted: true
tap "homebrew/services"

brew "bun"
brew "cairo"
brew "cmatrix"
brew "csvkit"
brew "fastfetch"
brew "ffmpeg"
brew "gemini-cli"
brew "gh"
brew "gnu-sed"
brew "go"
brew "golang-migrate"
brew "graphviz"
brew "heroku"
brew "htop"
brew "icu4c@76"
brew "imagemagick"
brew "jq"
brew "kompose"
brew "kubeconform"
brew "leetsolv"
brew "libmicrohttpd"
brew "lima"
brew "llama.cpp"
brew "lsd"
brew "lua"
brew "luarocks"
brew "minikube"
brew "mlx"
brew "mlx-c"
brew "tree-sitter"
brew "ocrmypdf"
brew "p7zip"
brew "podman"
brew "qemu"
brew "redis"
brew "sevenzip"
brew "socat"
brew "sqlc"
brew "terraform"
brew "tilt"
brew "unbound"
brew "uv"
brew "xmlstarlet"
brew "yarn"
brew "yt-dlp"
brew "gromgit/fuse/ntfs-3g-mac"

